# Track only the custom Nest Assured build and project documents.
# WordPress core, third-party plugins, the SQLite database (contains enquiry
# personal data), caches and uploads are reinstallable or must not be committed.
/*
!/.gitignore
!/.gitattributes
!/*.md
!/wp-content/
/wp-content/*
!/wp-content/themes/
/wp-content/themes/*
!/wp-content/themes/nest-assured/
!/wp-content/plugins/
/wp-content/plugins/*
!/wp-content/plugins/nest-assured-core/
!/wp-content/mu-plugins/
/wp-content/mu-plugins/*
!/wp-content/mu-plugins/na-performance-router.php

# Claude design workflow skill (needed by cloud sessions)
!/.claude/
/.claude/*
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/design-with-taste/
